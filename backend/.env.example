# --- Servidor ---
PORT=4000
NODE_ENV=development
# Dominio base sobre el que se resuelven los subdominios de cada institucion
# ej: shemuel.app  ->  udi.shemuel.app, unab.shemuel.app, etc.
BASE_DOMAIN=shemuel.app

# --- PostgreSQL (datos estructurados: instituciones, usuarios, asignaciones, evaluaciones) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=shemuel_plus
PG_USER=postgres
PG_PASSWORD=admin

# --- MongoDB (datos flexibles: planes de clase, hojas de vida, observaciones, evidencias) ---
MONGO_URI=mongodb://localhost:27017/shemuel_plus

# --- Autenticacion ---
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h
