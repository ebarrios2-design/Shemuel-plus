# --- Servidor ---
PORT=4000
NODE_ENV=development
BASE_DOMAIN=shemuel.app

# --- PostgreSQL local ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=shemuel_plus
PG_USER=postgres
PG_PASSWORD=

# --- Supabase PostgreSQL ---
# Copia la URI de Connect > Session pooler. Mantén las credenciales reales solo en .env.
SUPABASE_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@<POOLER_HOST>:5432/postgres
PG_CONNECTION_STRING=postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@<POOLER_HOST>:5432/postgres
PG_SSL=true
PG_SSL_ROOT_CERT=supabase-root.crt

# --- MongoDB ---
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGO_URI=

# --- Autenticacion ---
# Genera una clave aleatoria local; no reutilices ni publiques el valor de .env.
JWT_SECRET=
JWT_EXPIRES_IN=8h
