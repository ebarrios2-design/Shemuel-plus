# --- Servidor ---
PORT=4000
SACI_PORT=4001
SSRE_PORT=4002
NODE_ENV=development
BASE_DOMAIN=shemuel.app

# --- Servicios internos ---
SACI_URL=http://127.0.0.1:4001
SSRE_URL=http://127.0.0.1:4002
# Genera un valor secreto y configura el mismo en SACI y SSRE.
SACI_INTERNAL_TOKEN=replace-with-a-long-random-secret

# --- PostgreSQL local ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=shemuel_plus
PG_USER=postgres
PG_PASSWORD=admin

# --- Supabase PostgreSQL ---
# Copia la URI de Connect > Session pooler. Mantén las credenciales reales solo en .env.
SUPABASE_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@<POOLER_HOST>:5432/postgres
PG_CONNECTION_STRING=postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@<POOLER_HOST>:5432/postgres
PG_SSL=true
PG_SSL_ROOT_CERT=supabase-root.crt

# --- MongoDB ---
MONGODB_USERNAME=<MONGODB_USER>
MONGODB_PASSWORD=<MONGODB_PASSWORD>
MONGO_URI=mongodb+srv://<MONGODB_USER>:<MONGODB_PASSWORD>@<CLUSTER_HOST>/

# --- Autenticacion ---
# Genera una clave aleatoria local; no reutilices ni publiques el valor de .env.
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=8h
